{
    "version": 2,
    "builds": [
      {
        "src": "server/app.py",
        "use": "@vercel/python"
      },
      {
        "src": "client/package.json",
        "use": "@vercel/next",
        "config": {
          "distDir": "client/.next"
        }
      }
    ],
    "routes": [
      {
        "src": "/api/(.*)",
        "dest": "server/app.py"
      },
      {
        "src": "/(.*)",
        "dest": "client/$1"
      }
    ]
}